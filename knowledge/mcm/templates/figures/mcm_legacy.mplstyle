# Legacy tutorial style. Use explicitly; journal is the default theme.
figure.dpi: 120
figure.facecolor: white
figure.edgecolor: white
figure.constrained_layout.use: False
figure.figsize: 7, 6.5

font.size: 12
font.family: serif
font.serif: Times New Roman, Microsoft YaHei, Source Han Sans SC, Noto Sans CJK SC, SimSun, DejaVu Serif
mathtext.fontset: stix
axes.unicode_minus: False

axes.linewidth: 2.4
axes.labelsize: 14
axes.titlesize: 14
axes.titleweight: bold
axes.labelweight: bold
axes.spines.top: True
axes.spines.right: True
axes.edgecolor: 000000
axes.labelcolor: 000000
axes.grid: False

xtick.major.size: 6
xtick.major.width: 2.2
xtick.labelsize: 11
xtick.color: 000000
xtick.direction: out
ytick.major.size: 6
ytick.major.width: 2.2
ytick.labelsize: 11
ytick.color: 000000
ytick.direction: out

lines.linewidth: 3
lines.markersize: 8
lines.markeredgewidth: 1.2
patch.linewidth: 2
legend.frameon: False

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.04
savefig.facecolor: white
savefig.edgecolor: white
